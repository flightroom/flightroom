{
    "id": "a1e9a3f2-1234-5678-9abc-def123456789",
    "name": "mfe-orchestrator-upload",
    "friendlyName": "Upload Frontend Bundle to Flightroom",
    "description": "Zip and upload a frontend bundle to Flightroom",
    "helpMarkDown": "",
    "category": "Utility",
    "author": "Flightroom",
    "version": {
        "Major": 1,
        "Minor": 0,
        "Patch": 0
    },
    "instanceNameFormat": "Upload Frontend $(microfrontendSlug) v$(version)",
    "runsOn": ["Agent", "DeploymentGroup"],
    "visibility": ["Build", "Release"],
    "inputs": [
        {
            "name": "apiKey",
            "type": "string",
            "label": "API Key",
            "defaultValue": "",
            "required": true,
            "helpMarkDown": "Flightroom MANAGER deploy API key",
            "properties": {
                "IsSecret": "true"
            }
        },
        {
            "name": "microfrontendSlug",
            "type": "string",
            "label": "Frontend Slug",
            "defaultValue": "",
            "required": true,
            "helpMarkDown": "The BUNDLE frontend slug"
        },
        {
            "name": "domain",
            "type": "string",
            "label": "Flightroom URL",
            "defaultValue": "https://console.flightroom.dev",
            "required": true,
            "helpMarkDown": "Flightroom base URL, without /api"
        },
        {
            "name": "filePath",
            "type": "filePath",
            "label": "File or Directory Path",
            "defaultValue": "",
            "required": true,
            "helpMarkDown": "The file or directory to zip and upload"
        },
        {
            "name": "version",
            "type": "string",
            "label": "Version",
            "defaultValue": "",
            "required": true,
            "helpMarkDown": "The frontend version"
        }
    ],
    "execution": {
        "Node20_1": {
            "target": "index.js",
            "argumentFormat": ""
        }
    }
}
