{
    "$schema": "https://turbo.build/schema.json",
    "ui": "tui",
    "tasks": {
        "typecheck": {},
        "build": {
            "dependsOn": ["^build"],
            "outputs": ["dist/**", "build/**"]
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "format": {
            "cache": false
        },
        "lint": {
            "dependsOn": ["^lint"]
        },
        "test": {
            "dependsOn": ["^build"]
        }
    }
}
