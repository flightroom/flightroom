{
    "name": "@flightroom/backend",
    "version": "1.0.0",
    "description": "Backend service for Flightroom",
    "main": "index.js",
    "scripts": {
        "start": "nodemon --watch src --ext ts,json --exec tsx ./src/index.ts",
        "st": "tsx ./src/index.ts",
        "dev": "pnpm run start",
        "build": "tsc && node ./postbuild.js",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "lint": "biome lint --write ./src",
        "format": "biome format --write ./src",
        "docs:index": "node ./scripts/build-docs-index.js",
        "typecheck": "pnpm exec tsc --noEmit && pnpm exec tsc --noEmit -p tsconfig.test.json"
    },
    "keywords": [],
    "author": "",
    "license": "Apache-2.0",
    "packageManager": "pnpm@10.19.0",
    "dependencies": {
        "@anthropic-ai/bedrock-sdk": "^1.1.0",
        "@anthropic-ai/foundry-sdk": "^1.1.0",
        "@anthropic-ai/sdk": "^1.3.0",
        "@aws-sdk/client-s3": "^3.1160.0",
        "@aws-sdk/s3-request-presigner": "^3.1160.0",
        "@azure/identity": "^4.14.1",
        "@azure/storage-blob": "^12.34.0",
        "@fastify/autoload": "^6.5.1",
        "@fastify/cors": "^11.3.1",
        "@fastify/env": "^7.0.1",
        "@fastify/helmet": "^13.2.0",
        "@fastify/multipart": "^10.1.6",
        "@fastify/rate-limit": "^11.2.1",
        "@fastify/sensible": "^6.0.7",
        "@fastify/swagger": "^9.9.2",
        "@fastify/swagger-ui": "^6.1.2",
        "@google-cloud/storage": "^8.4.0",
        "@google/genai": "^2.32.0",
        "@modelcontextprotocol/node": "2.1.2",
        "@modelcontextprotocol/server": "2.4.0",
        "@nvidia/openshell-sdk": "0.1.6",
        "@redis/client": "^6.3.1",
        "@sentry/node": "^11.10.0",
        "adm-zip": "^0.6.1",
        "axios": "^1.21.0",
        "bcryptjs": "^3.0.3",
        "dotenv": "^18.0.9",
        "fastify": "^5.12.7",
        "fastify-auth0-verify": "^4.1.4",
        "fastify-plugin": "^6.0.1",
        "fs-extra": "^11.4.1",
        "isomorphic-git": "^1.44.8",
        "jose": "6.2.14",
        "jsonwebtoken": "^9.0.3",
        "juice": "^12.2.1",
        "libsodium-wrappers": "^0.8.4",
        "mongoose": "^9.11.4",
        "mssql": "^12.7.13",
        "mysql2": "^3.24.6",
        "nodemailer": "^10.3.1",
        "openai": "^7.45.1",
        "oracledb": "^26.0.0",
        "pg": "^8.23.1",
        "pug": "^3.0.4",
        "xstate": "^5.33.3",
        "yaml": "2.9.1",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@types/fs-extra": "^11.0.4",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/mssql": "^12.3.0",
        "@types/node": "^26.6.6",
        "@types/oracledb": "^26.0.1",
        "@types/pg": "^8.23.1",
        "@types/pug": "^2.0.10",
        "@vitest/coverage-v8": "^5.0.5",
        "nodemon": "^3.1.14",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2",
        "vitest": "^5.0.5"
    }
}
