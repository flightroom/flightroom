//- Layout shared by every transactional email. Colors, font, radii and shadows
//- come from the design system (design-system/src/styles/theme.css), converted
//- to hex because email clients need literal values:
//-   primary            hsl(24 99% 59%)  -> #FE7F2D  (pumpkin-400)
//-   primary-foreground hsl(201 73% 10%) -> #07202D  (testo scuro sul pumpkin: il bianco si ferma a 2.5:1)
//-   primary-active     hsl(26 92% 47%)  -> #E4690A
//-   primary-strong     hsl(27 97% 37%)  -> #BC5503  (link e accenti su bianco)
//-   foreground         hsl(203 37% 22%) -> #233D4D  (charcoal-900)
//-   muted-fg           hsl(204 19% 42%) -> #566E7E
//-   border             hsl(206 25% 89%) -> #DCE4EA
//-   dark surface       hsl(201 48% 13%) -> #112631
//-   page bg            --muted           #F1F5F8
//-   radius         0.75rem (card: +2px)
doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title= subject
    style(type="text/css").
      @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600&display=swap');
      body {
        font-family: 'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif;
        line-height: 1.5;
        letter-spacing: 0.0125em;
        color: #233D4D;
        background-color: #F1F5F8;
        margin: 0;
        padding: 0;
      }
      .container {
        max-width: 600px;
        margin: 0 auto;
        padding: 2rem;
      }
      .card {
        background: white;
        border-radius: 0.875rem;
        box-shadow: 0 1px 4px rgba(7, 32, 45, 0.06), 0 1px 2px rgba(7, 32, 45, 0.04);
        overflow: hidden;
        border: 1px solid #DCE4EA;
      }
      .header {
        background-color: #112631;
        color: white;
        padding: 1.5rem;
        text-align: center;
      }
      .content {
        padding: 2rem;
      }
      .button {
        display: inline-block;
        background-color: #FE7F2D;
        color: #07202D !important;
        text-decoration: none;
        padding: 0.75rem 1.5rem;
        border-radius: 0.75rem;
        font-weight: 500;
        margin: 1.5rem 0;
      }
      .button:hover {
        background-color: #E4690A;
      }
      .muted {
        color: #566E7E;
        font-size: 0.875rem;
      }
      a.link {
        color: #BC5503;
        word-break: break-all;
        font-size: 0.875rem;
      }
      .accent {
        color: #BC5503;
      }
      .footer {
        text-align: center;
        padding: 1.5rem;
        color: #566E7E;
        font-size: 0.875rem;
        border-top: 1px solid #DCE4EA;
      }
  body
    .container
      .card
        if headerIcon
          .header
            h1(style="margin: 0; font-size: 1.5rem;") #{headerIcon} #{header}
        else
          .header
            h1(style="margin: 0; font-size: 1.5rem;") #{header}
        .content
          block content
        .footer
          p(style="margin: 0;")
            if footerText
              | #{footerText}
              br
            | Flightroom — this is an automated message, please do not reply.
